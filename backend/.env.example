# ---------- Server ----------
NODE_ENV=development            # set to "production" on Render
PORT=4000

# ---------- Database (PostgreSQL 15+) ----------
# Local:  postgres://farm:farm@localhost:5432/soilsense
# Neon:   postgres://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/soilsense?sslmode=require
DATABASE_URL=postgres://farm:farm@localhost:5432/soilsense
DATABASE_SSL=false              # true for Neon / Supabase / Render
DB_POOL_MAX=10

# ---------- Auth ----------
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=1d
JWT_TTL_REMEMBER=30d

# ---------- CORS / links ----------
# Comma-separated list of allowed frontend origins. Wildcard subdomains allowed: *.pages.dev
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173   # used in e-mail links

# ---------- IoT ingestion ----------
# Gateways send this as the X-Device-Key header to POST /api/readings
INGEST_API_KEY=change-me-device-key

# ---------- Optional: e-mail (verification, password reset, PDF report) ----------
# Without SMTP, e-mails are printed to the server log instead.
# Free options: Brevo (300/day), Resend (100/day), Gmail app password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SoilSense <no-reply@yourdomain.in>"

# ---------- Optional ----------
WEATHER_ENABLED=true            # Open-Meteo (free, no key)
# Seed options: SEED_DAYS=14  SEED_STEP_H=2
